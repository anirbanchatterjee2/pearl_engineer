# Copy to .env and fill in your key.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown).
# PEARL_DIAGRAMS_DIR=diagrams
# PEARL_DATA_DIR=data
# PEARL_DESCRIPTIONS_FILE=data/descriptions.json
# CHROMA_PERSIST_DIR=data/chroma_db
# CHROMA_COLLECTION=diagrams
# EMBEDDING_MODEL=text-embedding-3-small
# PEARL_VISION_MODEL=gpt-4o-mini
# PEARL_CHAT_MODEL=gpt-4o-mini

# Semantic cache (used by `pearl serve` and `pearl ask`).
# PEARL_CACHE_ENABLED=true
# PEARL_CACHE_SIMILARITY_THRESHOLD=0.92
# PEARL_CACHE_TTL_SECONDS=3600
# PEARL_CACHE_MAX_ENTRIES=1024

# Require this value in the X-Admin-Token header for POST /cache/clear.
# PEARL_ADMIN_TOKEN=
